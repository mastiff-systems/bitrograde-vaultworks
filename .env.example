# ─── Backend ───────────────────────────────────────────────
DATABASE_URL=postgres://vaultworks:vaultworks@localhost:5432/vaultworks

# Digital Ocean Spaces (or any S3-compatible endpoint)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=vaultworks-assets
S3_REGION=nyc3
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

PORT=3001
CORS_ORIGIN=http://localhost:5173

# ─── Authentication ─────────────────────────────────────────
# AUTH_PROVIDER: "local" (default) or "keycloak"
AUTH_PROVIDER=local

# Required for local auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-use-a-strong-random-secret
JWT_EXPIRY=24h

# Required when AUTH_PROVIDER=keycloak
# KEYCLOAK_JWKS_URI=https://your-keycloak/realms/your-realm/protocol/openid-connect/certs

# ─── Frontend (Vite) ───────────────────────────────────────
VITE_API_URL=http://localhost:3001

# Auth provider for the frontend UI — must match backend AUTH_PROVIDER
VITE_AUTH_PROVIDER=local

# Required when VITE_AUTH_PROVIDER=keycloak
# VITE_KEYCLOAK_URL=https://your-keycloak
# VITE_KEYCLOAK_REALM=your-realm
# VITE_KEYCLOAK_CLIENT_ID=vaultworks
