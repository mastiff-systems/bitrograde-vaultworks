# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vaultworks

# Auth
JWT_SECRET=changeme
AUTH_PROVIDER=local

# CORS — required in production (NODE_ENV=production)
# CORS_ORIGIN=https://vaultworks.example.com

# Security headers
# Uncomment to enable Helmet's default Content-Security-Policy
# HELMET_CSP=true
