generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String         @unique
  passwordHash           String         @map("password_hash")
  role                   String         @default("user")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  passwordResetToken     String?        @map("password_reset_token") @db.Text
  passwordResetExpiresAt DateTime?      @map("password_reset_expires_at") @db.Timestamptz(6)
  mustChangePassword     Boolean        @default(false) @map("must_change_password")
  notifications Notification[]
  assetVersions AssetVersion[]
  folders       Folder[]       @relation("FolderCreator")
  uploadedAssets Asset[]       @relation("AssetUploader")
  auditLogs     AuditLog[]
  collections   Collection[]
  shareLinks    ShareLink[]

  @@index([passwordResetToken])
  @@map("users")
}

model Category {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String        @unique
  slug             String        @unique
  allowedMimeTypes String[]      @map("allowed_mime_types")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  subcategories    Subcategory[]
  assets           Asset[]

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  name       String
  slug       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Asset {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalName    String         @map("original_name")
  mimeType        String?        @map("mime_type")
  sizeBytes       BigInt?        @map("size_bytes")
  storageKey      String         @unique @map("storage_key")
  assetType       String?        @map("asset_type")
  thumbnailKey    String?        @map("thumbnail_key")
  description     String?        @map("description")
  uploadedAt      DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  uploadedBy      String?        @map("uploaded_by") @db.Uuid
  categoryId      String?        @map("category_id") @db.Uuid
  subcategoryId   String?        @map("subcategory_id") @db.Uuid
  license         String?
  resolutionW     Int?           @map("resolution_w")
  resolutionH     Int?           @map("resolution_h")
  durationSeconds Float?         @map("duration_seconds")
  tags            AssetTag[]
  notifications   Notification[]
  versions        AssetVersion[]
  folders         FolderAsset[]
  auditLogs       AuditLog[]
  collectionAssets CollectionAsset[]
  shareLink       ShareLink?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory     Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  uploader        User?          @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([uploadedBy])
  @@map("assets")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  resourceId String?  @map("resource_id") @db.Uuid
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Asset? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Tag {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  assets    AssetTag[]

  @@map("tags")
}

model AssetTag {
  assetId String @map("asset_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@map("asset_tags")
}

model AssetVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  versionNumber Int      @map("version_number")
  storageKey    String   @map("storage_key")
  sizeBytes     BigInt?  @map("size_bytes")
  mimeType      String?  @map("mime_type")
  message       String?
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@unique([assetId, versionNumber])
  @@index([assetId])
  @@map("asset_versions")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model Folder {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  parentFolderId  String?  @map("parent_folder_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?         @relation("FolderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parent    Folder?       @relation("FolderChildren", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children  Folder[]      @relation("FolderChildren")
  assets    FolderAsset[]

  @@index([createdByUserId])
  @@index([parentFolderId])
  @@map("folders")
}

model FolderAsset {
  folderId String @map("folder_id") @db.Uuid
  assetId  String @map("asset_id") @db.Uuid

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([folderId, assetId])
  @@index([assetId])
  @@map("folder_assets")
}

// ─── Audit Log ──────────────────────────────────────────────────────────────

enum AuditAction {
  UPLOAD
  DOWNLOAD
  VIEW
  UPDATE
  DELETE
  SHARE
  REVOKE_SHARE
  UPDATE_METADATA

  @@map("audit_action")
}

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  assetId   String?     @map("asset_id") @db.Uuid
  action    AuditAction
  details   Json        @default("{}")
  assetName String?     @map("asset_name")
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Collections ────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  assets  CollectionAsset[]

  @@index([createdBy])
  @@map("collections")
}

model CollectionAsset {
  collectionId String   @map("collection_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
  @@index([collectionId])
  @@index([assetId])
  @@map("collection_assets")
}

// ─── Share Links ────────────────────────────────────────────────────────────

model ShareLink {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token           String    @unique
  assetId         String    @unique @map("asset_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  asset         Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("share_links")
}
